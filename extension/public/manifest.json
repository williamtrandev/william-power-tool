{
  "manifest_version": 3,
  "name": "William Tool – Điền tài khoản",
  "short_name": "William Tool",
  "version": "0.3.0",
  "description": "Điền tên đăng nhập, mật khẩu và mã OTP từ tab Tài khoản của William Tool vào trang đăng nhập.",
  "key": "",
  "icons": {
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    },
    "default_title": "William Tool – Điền tài khoản"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "identity",
    "clipboardWrite",
    "alarms"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Mở bảng điền tài khoản"
    }
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inline.html",
        "assets/*",
        "icon.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
